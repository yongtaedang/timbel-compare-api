# timbel-compare-api 환경 변수 템플릿(git 추적됨). 실제 값은 VM의 .env에 둔다.
# 전부 선택 사항이다 — 하나도 없이도 기본값으로 뜬다(src/compare_api/config.py).

# 라우트 접두사. 프론트의 NEXT_PUBLIC_API_URL과 합쳐져 최종 주소가 된다.
API_PREFIX=/api/compare/v1

# CORS 허용 origin(콤마 구분). 프론트가 브라우저에서 직접 호출하므로 반드시 실제 프론트
# 주소를 넣어야 한다. 예: https://compare.timbel.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 요청 하나의 상한
MAX_FILES=2000
MAX_FILE_MB=10
MAX_TOTAL_MB=512

# 비교 프로세스에 넘길 수 있는 최대 워커 수(-w). 기본값은 서버 코어 수.
MAX_WORKERS=

# 비교 한 건을 기다리는 한계(초). 넘으면 프로세스를 죽이고 504.
TIMEOUT_SECONDS=1800

# 동시에 돌릴 비교 작업 수. 하나가 코어를 다 쓰므로 작게 유지한다.
MAX_CONCURRENT_JOBS=2
